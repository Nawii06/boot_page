# Optional server settings. Blank values use the documented local defaults.
# HOST: 127.0.0.1. Non-loopback binding also requires ALLOW_NETWORK=true.
HOST=
# API / built app port: 3000
PORT=
# Frontend development port: 5173
DEV_PORT=
# Explicit opt-in for network binding; default false.
ALLOW_NETWORK=
# Private local paths: relative paths resolve from the project root.
# Database file default: ./var/db/bootcamp.sqlite (.sqlite/.sqlite3/.db required).
DB_PATH=
# Uploaded file originals; default ./var/uploads. Never point to public/source/build folders.
UPLOAD_DIR=
# Private migration/account safety snapshots; default ./var/backups.
# Content export uses an explicit --output directory (recommended: under ./var/backups).
BACKUP_DIR=
# Exact browser origin for authentication/CSRF (no path or trailing slash).
# Blank: loopback localhost/127.0.0.1/[::1] at PORT and DEV_PORT.
# A non-loopback origin must use HTTPS with COOKIE_SECURE=true.
APP_ORIGIN=
# Local HTTP: false. HTTPS deployment: true (requires HTTPS APP_ORIGIN).
COOKIE_SECURE=
# Absolute session lifetime in seconds, 300..86400; default 28800 (8 hours).
SESSION_TTL_SECONDS=
# Per-file upload size in MiB; default 20, allowed 1..100.
MAX_UPLOAD_MB=
# Total storage quota in MiB, including unlinked files; default 512, allowed 1..102400.
MAX_STORAGE_MB=
# ZIP expanded bytes in MiB for DOCX/HWPX; default 100, allowed 1..500.
MAX_ZIP_EXPANDED_MB=
# Decoded raster image pixel limit; default 20000000, allowed 1..40000000.
MAX_IMAGE_PIXELS=
# Unique attachment/body/home image files per content; default 20, allowed 1..100.
MAX_FILES_PER_CONTENT=
# Do not add passwords, keys or private data to this example file.
