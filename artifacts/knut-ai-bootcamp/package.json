{
  "name": "@workspace/knut-ai-bootcamp",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.21.0",
    "npm": "11.19.0"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:web": "node scripts/replit-run.mjs web",
    "dev:api": "node scripts/replit-run.mjs api-dev",
    "serve:api": "node scripts/replit-run.mjs api",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.server.json",
    "start": "node dist/runtime/server/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "db:migrate": "tsx scripts/db.ts migrate",
    "db:seed": "tsx scripts/db.ts seed",
    "db:status": "tsx scripts/db.ts status",
    "admin:create": "tsx scripts/admin.ts create",
    "admin:reset": "tsx scripts/admin.ts reset",
    "content:export": "tsx scripts/content.ts export",
    "content:import": "tsx scripts/content.ts import",
    "source:package": "node scripts/package-source.mjs"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "busboy": "1.6.0",
    "cfb": "1.2.2",
    "express": "5.3.0",
    "lucide-react": "1.57.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "sanitize-html": "2.18.0",
    "saxes": "6.0.0",
    "sharp": "0.35.5",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/busboy": "1.5.5",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "2.16.2",
    "@types/yauzl": "3.4.0",
    "@vitejs/plugin-react": "6.1.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
